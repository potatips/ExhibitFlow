# Lightweight CPU-only Docker image for ExhibitFlow GPU Worker in --demo mode.
# Build context: GPU_server/
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/exhibitflow-gpu

RUN pip install --no-cache-dir \
    "fastapi>=0.115" \
    "uvicorn[standard]>=0.30" \
    "python-multipart>=0.0.9" \
    "psutil>=5.9" \
    "pillow>=10.0"

COPY worker ./worker
COPY exhibitflow_gpu/__init__.py ./exhibitflow_gpu/__init__.py
COPY launch.py ./launch.py

ENV PORT=8001
EXPOSE 8001

CMD ["sh", "-c", "python3 launch.py --demo --no-tunnel --host 0.0.0.0 --port ${PORT:-8001} --data-dir ${DATA_DIR:-/app/gpu_data}"]
