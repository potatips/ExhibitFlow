# Backend API authentication & CORS (recommended whenever exposed via tunnel)
BACKEND_API_KEY=
STREAM_TOKEN_TTL_S=600
CORS_ORIGINS=*

# Cloudflare Named Tunnel (optional, for --tunnel named)
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_BACKEND_URL=

# GPU Worker connection (e.g. Vast.ai cloudflared tunnel URL and shared secret token)
GPU_WORKER_URL=http://127.0.0.1:8001
GPU_TOKEN=

# State store: leave REDIS_URL empty to use SQLite (default)
REDIS_URL=
DATA_DIR=./backend_data
# SQLITE_PATH=./backend_data/state.db

# Artifact storage: "local" (default) or "vercel_blob"
ARTIFACT_STORE=local
BLOB_READ_WRITE_TOKEN=

# Static web UI directory (auto-detected as <repo>/web if present)
# WEB_DIR=../web

# Upload limit & dispatcher polling intervals
MAX_UPLOAD_MB=600
POLL_INTERVAL_S=0.5
HEALTH_INTERVAL_S=2.0
PORT=8000
