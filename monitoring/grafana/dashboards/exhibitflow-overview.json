        {
          "expr": "exhibitflow_gpu_online",
          "legendFormat": "GPU Online",
          "refId": "A"
        },
        {
          "expr": "exhibitflow_gpu_ready",
          "legendFormat": "GPU Ready",
          "refId": "B"
        },
        {
          "expr": "exhibitflow_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
