# ExhibitFlow 3-Tier Docker Compose Environment Example
# Copy to .env and fill in values before running production or GPU profiles.

# --- Shared Authentication ---
# Leave BACKEND_API_KEY empty for frictionless local demo, or set a strong secret for exposed deployments.
BACKEND_API_KEY=
GPU_TOKEN=demo-local-gpu-token

# --- GPU Worker (used by `--profile gpu`) ---
HF_TOKEN=
MODE=full
# GPU_WORKER_URL defaults to http://gpu-demo:8001 in docker-compose.yml (or http://gpu-worker:8001 with --profile gpu)
# GPU_WORKER_URL=http://gpu-worker:8001

# --- Optional Redis StateStore (`--profile redis`) ---
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# --- Monitoring (`--profile monitoring`) ---
METRICS_PUBLIC=1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- CORS ---
CORS_ORIGINS=*
